#!/usr/bin/env python3
"""
pre-commit — four checks:

  1. business_owner_map.json going stale relative to the Parishioner
     Businesses section it's supposed to be generated from, at commit
     time instead of needing someone to remember `python3 build.py`.
     Fires when a drafts/<date>.both.html master is staged.
  2. (added 2026-11-02) drafts/<date>.html/.serbian.html/.other.html/
     .site.html going stale relative to .both.html -- delegates to
     check_build_freshness.check(), see that module's docstring for the
     2026-11-02 incident that motivated it (a hand-edit applied to all
     four generated files instead of rebuilding from the master, with
     the hand-edit itself incomplete on .site.html). Fires when a
     drafts/<date>.both.html master is staged.
  3. (added 2026-11-02) drafts/<date>.email.html going stale relative to
     the approved drafts/<date>.both.html master -- delegates to
     check_email_consistency.check(), see that module's docstring for the
     2026-10-08 incident that motivated the underlying script (a board
     correction to both.html left two stale values in email.html,
     caught only because the draft happened to be read closely before
     the Beehiiv load). Previously only ran as part of
     prepare_publish.py's fast path at final-publish time; fires here
     too, at ordinary commit time, so a mid-week correction gets flagged
     days earlier. Fires when EITHER drafts/<date>.both.html OR
     drafts/<date>.email.html is staged (either side of the drift could
     be the one changing).

  4. (added 2026-11-02) a cancelled/removed item from a past issue
     silently reappearing in the current draft -- delegates to
     check_board_resolutions.check(), see that module's docstring for
     the 2026-10-29 Krajina Evening incident that motivated it (a
     confirmed-cancelled dinner got re-added by copying forward from a
     stale draft). Pure git-history + local-file scan, no network call
     (~1.5s at this repo's current commit count) -- unlike
     check_calendar.py, which fetches stnicholasphilly.org live and is
     deliberately NOT wired in here for the same reason the live
     business_owner_map DB comparison below was rejected. Fires when a
     drafts/<date>.both.html master is staged.

Checks 1-2 and 4 only fire when a drafts/<date>.both.html master is part
of the commit; every other commit is an instant no-op for those three.
Check 3 has its own, slightly broader trigger -- see above.

Tracked here as hooks/pre-commit; install_precommit_hook.sh copies it into
.git/hooks/pre-commit (git hooks are never version-controlled themselves,
so that copy step is required).

WARN-ONLY, same as git_staging_guard.py's pattern for this repo: prints a
warning on drift but ALWAYS exits 0. Never blocks an ordinary commit, per
feedback_always_commit_git (HARD).

Deliberately does NOT re-run check_business_owner_sync.py's live-DB
comparison here -- tried that first, but it only has `--offline` available
inside a hook (a live wrangler call on every commit is slow/flaky), and the
local backup snapshot can be arbitrarily stale (caught this for real: it
reported two "problems" that were already fixed in the live DB hours
earlier, because the backup predated the fix). A pre-commit check that can
confidently cry wolf is worse than no check. What IS deterministic and
worth checking locally: whether business_owner_map.json actually reflects
the draft(s) being committed right now. The live-DB comparison stays a
manual step (README Step 1 / `check_business_owner_sync.py` with no flags).
"""
import subprocess
import sys
from pathlib import Path

# NOTE: __file__ is NOT reliable for locating the repo root here -- this
# script is COPIED (not symlinked) into .git/hooks/pre-commit by
# install_precommit_hook.sh, which puts it two directories deeper than the
# tracked hooks/pre-commit source. Ask git directly instead.
REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip()
)
sys.path.insert(0, str(REPO_ROOT))

import extract_business_owner_map as eom  # noqa: E402
import check_build_freshness  # noqa: E402
import check_email_consistency  # noqa: E402
import check_board_resolutions  # noqa: E402
from check_utils import CheckError  # noqa: E402


def staged_drafts(suffix):
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        cwd=REPO_ROOT, capture_output=True, text=True,
    )
    return [
        REPO_ROOT / line
        for line in result.stdout.splitlines()
        if line.startswith("drafts/") and line.endswith(suffix)
    ]


def staged_both_html_files():
    return staged_drafts(".both.html")


def current_map():
    if not eom.MAP_PATH.exists():
        return {}
    import json
    data = json.loads(eom.MAP_PATH.read_text(encoding="utf-8"))
    return {k: v for k, v in data.items() if not k.startswith("_")}


def main():
    drafts = staged_both_html_files()
    email_drafts = staged_drafts(".email.html")
    if not drafts and not email_drafts:
        return 0

    _check_business_owner_map(drafts)
    _check_build_freshness(drafts)
    _check_email_consistency(drafts, email_drafts)
    _check_board_resolutions(drafts)
    return 0


def _check_business_owner_map(drafts):
    if not drafts:
        return
    on_disk_map = current_map()
    problems = []

    for draft in drafts:
        owner_map, errors = eom.extract(draft)
        if errors:
            problems.append(f"{draft.name}: {'; '.join(errors)}")
            continue
        if not owner_map:
            continue  # this draft has no Parishioner Businesses section (nothing to check)
        for slug, name in owner_map.items():
            if on_disk_map.get(slug) != name:
                problems.append(
                    f"{draft.name}: slug={slug!r} shows '{name}' but business_owner_map.json "
                    f"has {on_disk_map.get(slug)!r}"
                )

    if problems:
        print("⚠️  pre-commit WARNING: business_owner_map.json is stale relative to the draft(s) being committed:")
        for p in problems:
            print(f"    - {p}")
        print("    Run `python3 build.py drafts/<date>.both.html`, then `git add business_owner_map.json`.")
        print("    Commit proceeding anyway -- this is advisory only.")


def _check_build_freshness(drafts):
    if not drafts:
        return
    stale_builds = []
    for draft in drafts:
        date = draft.name.replace(".both.html", "")
        try:
            stale = check_build_freshness.check(date)
        except CheckError as e:
            stale_builds.append(f"{draft.name}: {e}")
            continue
        stale_builds.extend(f"{draft.name}: {s}" for s in stale)

    if stale_builds:
        print("⚠️  pre-commit WARNING: generated draft variant(s) out of sync with the master being committed:")
        for s in stale_builds:
            print(f"    - {s}")
        print("    Run `python3 build.py drafts/<date>.both.html` then `python3 build_site_html.py drafts/<date>.both.html`,")
        print("    re-add the regenerated files, and amend/recommit.")
        print("    Commit proceeding anyway -- this is advisory only.")


def _check_email_consistency(drafts, email_drafts):
    # Either side of the drift could be the one staged -- a .both.html
    # correction with no matching email.html edit, OR an email.html edit
    # alone (e.g. a wording tweak) that now disagrees with the approved
    # master. Union the dates from both, dedup, check each once.
    dates = {d.name.replace(".both.html", "") for d in drafts}
    dates |= {d.name.replace(".email.html", "") for d in email_drafts}

    email_problems = []
    for date in sorted(dates):
        both_path = REPO_ROOT / "drafts" / f"{date}.both.html"
        email_path = REPO_ROOT / "drafts" / f"{date}.email.html"
        if not both_path.exists() or not email_path.exists():
            # Step 1 writes .both.html and .email.html separately -- early
            # in the week one can legitimately exist without the other yet.
            # That's "not drafted yet," not drift; nothing to compare.
            continue
        try:
            problems, warnings = check_email_consistency.check(date)
        except CheckError as e:
            email_problems.append(f"{date}: {e}")
            continue
        email_problems.extend(f"{date}: {p}" for p in problems)
        email_problems.extend(f"{date}: {w}" for w in warnings)

    if email_problems:
        print("⚠️  pre-commit WARNING: drafts/<date>.email.html out of sync with the approved drafts/<date>.both.html:")
        for p in email_problems:
            print(f"    - {p}")
        print("    Review both.html's board-approved content against email.html before the Beehiiv load (README Step 5).")
        print("    Commit proceeding anyway -- this is advisory only.")


def _check_board_resolutions(drafts):
    if not drafts:
        return
    resolution_hits = []
    for draft in drafts:
        date = draft.name.replace(".both.html", "")
        try:
            hits, _phrase_count = check_board_resolutions.check(date)
        except CheckError as e:
            resolution_hits.append(f"{draft.name}: {e}")
            continue
        resolution_hits.extend(
            f'{draft.name}: "{h["phrase"]}" -- flagged in commit {h["hash"]} ({h["date"]}): {h["subject"]}'
            for h in hits
        )

    if resolution_hits:
        print("⚠️  pre-commit WARNING: phrase(s) from a past cancellation/removal reappear in the draft being committed:")
        for r in resolution_hits:
            print(f"    - {r}")
        print("    Check the named commit before keeping this -- confirm it wasn't re-confirmed since, not just carried forward by habit.")
        print("    Commit proceeding anyway -- this is advisory only.")


if __name__ == "__main__":
    sys.exit(main())
